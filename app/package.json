{
  "name": "capri-espanol-desktop",
  "version": "0.2.0-es.2",
  "description": "Capri en español: compañera animada de escritorio",
  "author": "Capri en español contributors",
  "repository": "github:emmanuelquintana/capri-espanol",
  "main": "src/main/main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "demo": "node scripts/demo.js",
    "hooks:install": "node scripts/install-hooks.js",
    "hooks:uninstall": "node scripts/install-hooks.js --uninstall",
    "hooks:codex:install": "node scripts/install-codex-hooks.js",
    "hooks:codex:uninstall": "node scripts/install-codex-hooks.js --uninstall",
    "hooks:agy:install": "node scripts/install-hooks-agy.js",
    "hooks:agy:uninstall": "node scripts/install-hooks-agy.js --uninstall",
    "check:llm": "node scripts/check-llm.js",
    "test:hooks": "node --test tests/hooks.test.js",
    "dist": "electron-builder --win nsis --x64",
    "test": "node --test tests/*.test.js",
    "dist:dir": "electron-builder --win dir --x64"
  },
  "keywords": [
    "claude-code",
    "desktop-pet",
    "electron",
    "cyberpunk",
    "edgerunners"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "electron": "^44.9.3",
    "electron-builder": "^26.18.0",
    "playwright": "1.64.0-alpha-1790635538000"
  },
  "dependencies": {
    "@fontsource/chakra-petch": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0"
  },
  "build": {
    "appId": "com.emmanuelquintana.capri.espanol",
    "productName": "Capri en español",
    "files": [
      "src/**",
      "assets/**",
      "hooks/**",
      "scripts/**",
      "package.json",
      "LICENSE",
      "NOTICE.md"
    ],
    "asarUnpack": [
      "hooks/**",
      "src/main/windows.ps1"
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/icons/capri.ico"
    },
    "nsis": {
      "include": "build/installer.nsh",
      "oneClick": false,
      "perMachine": false,
      "runAfterFinish": true,
      "createDesktopShortcut": true,
      "shortcutName": "Capri en español",
      "artifactName": "Capri-Espanol-Setup-${version}.${ext}",
      "allowElevation": false,
      "allowToChangeInstallationDirectory": true,
      "createStartMenuShortcut": true,
      "installerLanguages": [
        "es"
      ],
      "displayLanguageSelector": false,
      "language": "3082",
      "deleteAppDataOnUninstall": false
    },
    "executableName": "CapriEspanol",
    "directories": {
      "output": "../entrega-desktop"
    },
    "extraResources": [
      {
        "from": "NOTICE.md",
        "to": "NOTICE.md"
      },
      {
        "from": "LICENSE",
        "to": "LICENSE-base.txt"
      }
    ]
  }
}
